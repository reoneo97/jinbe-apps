# Single-tenant credentials for the markdown editor.
AUTH_USERNAME=admin
# Generate with: python scripts/hash_password.py
AUTH_PASSWORD_HASH=

# Random secret used to sign session cookies. Generate with: openssl rand -hex 32
SECRET_KEY=

# Where note files are stored (mounted as a volume in Docker).
NOTES_DIR=/data

# Set to "true" once the app is served over HTTPS (recommended in production).
SESSION_HTTPS_ONLY=false
